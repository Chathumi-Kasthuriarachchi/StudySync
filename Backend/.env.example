# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studysync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES=15m

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Service (Resend) — https://resend.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# AWS S3 Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Chat Encryption (Phase 15)
# 32-byte hex key for AES-256-GCM message encryption at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Chat File Upload Limits (Phase 21) — values in MB
# CHAT_MAX_FILE_SIZE=100
# CHAT_MAX_IMAGE_SIZE=10
# CHAT_MAX_DOCUMENT_SIZE=25
# CHAT_MAX_ARCHIVE_SIZE=50
# CHAT_MAX_AUDIO_SIZE=50
# CHAT_MAX_VIDEO_SIZE=100

